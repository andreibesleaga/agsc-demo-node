    a asc:Concept ;
    skos:altLabel "context-isolated subagent"@en , "subagent (Claude Code)"@en , "tool-agents (OpenAI Agents SDK)"@en ;
    skos:definition "Wrap a specialist agent as a tool, so a calling agent can hand it one bounded task and keep control."@en ;
