e":"2023","dcterms:source":"https://slsa.dev/spec/v1.0/about","grade":"secondary","title":"About SLSA","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/","@type":"Concept","altLabel":[{"@language":"en","@value":"context-isolated subagent"},{"@language":"en","@value":"subagent (Claude Code)"},{"@language":"en","@value":"tool-agents (OpenAI Agents SDK)"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Wrap a specialist agent as a tool, so a calling agent can hand it one bounded task and keep control."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Agents as Tools"},"related":["https://patterns.agenticsystemcore.com/concepts/augmented-llm/","https://patterns.agenticsystemcore.com/concepts/blackboard/","https://patterns.agenticsystemcore.com/concepts/deep-research-loop/","https://patterns.agenticsystemcore.com/concepts/parallelization/","https://patterns.agenticsystemcore.com/concepts/skill-library/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-1","https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-2","https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-1","@type":"Source","creator":"OpenAI","date":"2025","dcterms:source":"https://openai.github.io/openai-agents-python/tools/#agents-as-tools","grade":"primary","title":"Tools","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-2","@type":"Source","creator":"OpenAI","date":"2025","dcterms:source":"https://openai.github.io/openai-agents-python/multi_agent/","grade":"secondary","title":"Agent orchestration","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-3","@type":"Source","creator":"Anthropic","date":"2026","dcterms:source":"https://code.claude.com/docs/en/sub-agents","grade":"secondary","title":"Create custom subagents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/augmented-llm/","@type":"Concept","altLabel":[{"@language":"en","@value":"LLM plus retrieval, tools and memory"},{"@language":"en","@value":"basic building block (Anthropic)"},{"@language":"en","@value":"language agent (CoALA)"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"A language model enhanced with retrieval, tools and memory that it uses actively, described by Anthropic as the basic building block of agentic systems."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Augmented LLM"},"related":["https://patterns.agenticsystemcore.com/concepts/agents-as-tools/","https://patterns.agenticsystemcore.com/concepts/retrieval-evaluation/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/augmented-llm/#source-1","https://patterns.agenticsystemcore.com/concepts/augmented-llm/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/augmented-llm/#source-1","@type":"Source","creator":"Schluntz, E.; Zhang, B.","date":"2024","dcterms:source":"https://www.anthropic.com/research/building-effective-agents","grade":"primary","title":"Building effective agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/augmented-llm/#source-2","@type":"Source","creator":"Sumers, T. R.; Yao, S.; Narasimhan, K.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2309.02427","grade":"secondary","title":"Cognitive Architectures for Language Agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"A six-level scale for how much an agent may decide alone, chosen per kind of action from risk, not from model capability."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"taxonomy","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Autonomy Ladder"},"related":["https://patterns.agenticsystemcore.com/concepts/meaningful-human-control/","https://patterns.agenticsystemcore.com/concepts/outcome-based-pricing/","https://patterns.agenticsystemcore.com/concepts/plan-approval-gate/","https://patterns.agenticsystemcore.com/concepts/shadow-mode-rollout/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-1","https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-1","@type":"Source","creator":"Reavis, J.","date":"2026","dcterms:source":"https://cloudsecurityalliance.org/blog/2026/01/28/levels-of-autonomy","grade":"primary","title":"Leveling Up Autonomy in Agentic AI","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-2","@type":"Source","creator":"Mitchell, M.; Ghosh, A.; Luccioni, A. S.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2502.02649","grade":"secondary","title":"Fully Autonomous AI Agents Should Not be Developed","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/blackboard/","@type":"Concept","altLabel":[{"@language":"en","@value":"opportunistic problem solving"},{"@language":"en","@value":"shared workspace"}],"created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"Independent specialists work on one problem through a shared workspace; a control step picks who contributes next."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Blackboard"},"related":["https://patterns.agenticsystemcore.com/concepts/agents-as-tools/","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/","https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/","https://patterns.agenticsystemcore.com/concepts/parallelization/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/blackboard/#source-1","https://patterns.agenticsystemcore.com/concepts/blackboard/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/blackboard/#source-1","@type":"Source","creator":"Erman, L. D.; Hayes-Roth, F.; Lesser, V. R.; et al.","date":"1980","dcterms:source":"https://mas.cs.umass.edu/Documents/Erman_Hearsay80.pdf","grade":"primary","title":"The Hearsay-II Speech-Understanding System: Integrating Knowledge to Resolve Uncertainty","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/blackboard/#source-2","@type":"Source","creator":"Han, B.; Zhang, S.","date":"2025","dcterms:source":"https://arxiv.org/abs/2507.01701","grade":"secondary","title":"Exploring Advanced LLM Multi-Agent Systems Based on Blackboard Architecture","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/","@type":"Concept","altLabel":[{"@language":"en","@value":"SemaphoreBulkhead / FixedThreadPoolBulkhead (resilience4j)"},{"@language":"en","@value":"bulkhead pattern (Azure Architecture Center)"},{"@language":"en","@value":"cell-based architecture"},{"@language":"en","@value":"per-tenant resource pools"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Give each agent, tenant or dependency its own bounded resource pool, so a fault or overload in one stays out of the others."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Bulkhead Isolation"},"related":["https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/#source-1","https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/#source-2","https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/#source-1","@type":"Source","creator":"Microsoft","date":"2026","dcterms:source":"https://learn.microsoft.com/en-us/azure/architecture/patterns/bulkhead","grade":"primary","title":"Bulkhead pattern","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/#source-2","@type":"Source","creator":"resilience4j","date":"2026","dcterms:source":"https://resilience4j.readme.io/docs/bulkhead","grade":"secondary","title":"Bulkhead","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/#source-3","@type":"Source","creator":"Wikipedia","date":"2026","dcterms:source":"https://en.wikipedia.org/wiki/Bulkhead_pattern","grade":"secondary","title":"Bulkhead pattern","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/","@type":"Concept","altLabel":[{"@language":"en","@value":"canary release for prompts"},{"@language":"en","@value":"prompt canary label (Langfuse)"},{"@language":"en","@value":"shadow testing (Statsig)"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Release a changed prompt or model to a small share of live traffic, or to a copy of it, and compare it with the current version before promoting."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Canary and Shadow Deployment for Prompts and Models"},"related":["https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/","https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/","https://patterns.agenticsystemcore.com/concepts/shadow-mode-rollout/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-1","https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-2","https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-1","@type":"Source","creator":"Warner, A.; Davidovič, Š.; Hidalgo, A.; et al.","date":"2018","dcterms:source":"https://sre.google/workbook/canarying-releases/","grade":"primary","title":"Canarying Releases","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-2","@type":"Source","creator":"Langfuse","date":"2026","dcterms:source":"https://langfuse.com/resources/engineering/prompt-cicd","grade":"secondary","title":"Prompt CI/CD: version, gate, and roll out prompts like code","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-3","@type":"Source","creator":"Statsig","date":"2025","dcterms:source":"https://www.statsig.com/perspectives/shadow-testing-ai-model-evaluation","grade":"secondary","title":"Shadow Testing for AI: How to Evaluate Models Without Affecting Users","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/card-format/","@type":"Concept","created":"2026-11-18T00:00:00Z","decidedBy":"https://patterns.agenticsystemcore.com/concepts/keep-cards-short/","definition":{"@language":"en","@value":"What a card of this node must hold, stated so that tasks can follow it and a check can test it."},"implementedBy":["https://patterns.agenticsystemcore.com/concepts/task-recheck-sources/","https://patterns.agenticsystemcore.com/concepts/task-report-a-broken-link/"],"inScheme":"https://patterns.agenticsystemcore.com/","isVerifiedBy":"https://patterns.agenticsystemcore.com/procedures/check-a-card-against-its-sources/","kind":"spec","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"Card format"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/","@type":"Concept","altLabel":[{"@language":"en","@value":"automatic curriculum from novelty"},{"@language":"en","@value":"curiosity reward for agents"},{"@language":"en","@value":"in-context novelty search"},{"@language":"en","@value":"intrinsic-motivation task proposal"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Choose an agent's next task from novelty or learning progress instead of a fixed task list, as in Voyager's automatic curriculum."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Curiosity-Driven Curriculum"},"related":["https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","https://patterns.agenticsystemcore.com/concepts/skill-library/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-1","https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-2","https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-3","https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-1","@type":"Source","creator":"Oudeyer, P.-Y.; Kaplan, F.","date":"2007","dcterms:source":"https://www.frontiersin.org/journals/neurorobotics/articles/10.3389/neuro.12.006.2007/full","grade":"primary","title":"What is intrinsic motivation? A typology of computational approaches","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-2","@type":"Source","creator":"Pathak, D.; Agrawal, P.; Efros, A. A.; et al.","date":"2017","dcterms:source":"https://arxiv.org/abs/1705.05363","grade":"secondary","title":"Curiosity-driven Exploration by Self-supervised Prediction","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-3","@type":"Source","creator":"Wang, G.; Xie, Y.; Jiang, Y.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2305.16291","grade":"secondary","title":"Voyager: An Open-Ended Embodied Agent with Large Language Models","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-4","@type":"Source","creator":"Hong, Z.; Shenfeld, I.; Wang, T.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2402.19464","grade":"secondary","title":"Curiosity-driven Red-teaming for Large Language Models","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"Split a question into parts, search them in parallel, combine the findings and check that every claim has a source."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Deep Research Loop"},"related":["https://patterns.agenticsystemcore.com/concepts/agents-as-tools/","https://patterns.agenticsystemcore.com/concepts/parallelization/","https://patterns.agenticsystemcore.com/concepts/retrieval-evaluation/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-1","https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-1","@type":"Source","creator":"Hadfield, J.; Zhang, B.; Lien, K.; et al.","date":"2025","dcterms:source":"https://www.anthropic.com/research/multi-agent-research-system","grade":"primary","title":"How we built our multi-agent research system","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-2","@type":"Source","creator":"Gottweis, J.; Natarajan, V.","date":"2025","dcterms:source":"https://research.google/blog/accelerating-scientific-breakthroughs-with-an-ai-co-scientist/","grade":"secondary","title":"Accelerating scientific breakthroughs with an AI co-scientist","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/","@type":"Concept","altLabel":[{"@language":"en","@value":"CaMeL"},{"@language":"en","@value":"capability-based prompt-injection defense"},{"@language":"en","@value":"privileged/quarantined LLM split"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Keep the model that can act away from untrusted text: a tool-less model reads it, and plain code passes results between them."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Dual-LLM Pattern"},"related":["https://patterns.agenticsystemcore.com/concepts/memory-context-poisoning/","https://patterns.agenticsystemcore.com/concepts/owasp-agentic-top-10/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-1","https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-1","@type":"Source","creator":"Willison, S.","date":"2023","dcterms:source":"https://simonwillison.net/2023/Apr/25/dual-llm-pattern/","grade":"primary","title":"The Dual LLM pattern for building AI assistants that can resist prompt injection","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-2","@type":"Source","creator":"Debenedetti, E.; Shumailov, I.; Fan, T.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2503.18813","grade":"secondary","title":"Defeating Prompt Injections by Design","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/","@type":"Concept","altLabel":[{"@language":"en","@value":"axial coding"},{"@language":"en","@value":"failure taxonomy"},{"@language":"en","@value":"open coding"},{"@language":"en","@value":"trace review to saturation"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Read traces, write open notes, then group them into a failure taxonomy, so the categories come from the data."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Error Analysis by Open and Axial Coding"},"related":["https://patterns.agenticsystemcore.com/concepts/judge-calibration/","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/#source-1","https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/#source-2","https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/#source-1","@type":"Source","creator":"Husain, H.; Shankar, S.","date":"2026","dcterms:source":"https://hamel.dev/blog/posts/evals-faq/","grade":"primary","title":"AI Evals: Everything You Need to Know","verifiedOn":"2026-11-18T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/#source-2","@type":"Source","creator":"Husain, H.","date":"2025","dcterms:source":"https://hamel.dev/blog/posts/field-guide/","grade":"secondary","title":"A Field Guide to Rapidly Improving AI Products","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/#source-3","@type":"Source","creator":"Shankar, S.; Zamfirescu-Pereira, J. D.; Hartmann, B.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2404.12272","grade":"secondary","title":"Who Validates the Validators? Aligning LLM-Assisted Evaluation of LLM Outputs with Human Preferences","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/","@type":"Concept","altLabel":[{"@language":"en","@value":"Promptbreeder-style mutation"},{"@language":"en","@value":"genetic-Pareto prompt search"},{"@language":"en","@value":"population-based prompt optimization"},{"@language":"en","@value":"prompt evolution"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Improve prompts by keeping a population, letting an LLM mutate and recombine it, scoring on a training set and keeping the fittest."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Evolutionary Prompt Search"},"related":["https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/","https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/","https://patterns.agenticsystemcore.com/concepts/shadow-mode-rollout/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/#source-1","https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/#source-2","https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/#source-1","@type":"Source","creator":"Guo, Q.; Wang, R.; Guo, J.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2309.08532","grade":"primary","title":"EvoPrompt: Connecting LLMs with Evolutionary Algorithms Yields Powerful Prompt Optimizers","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/#source-2","@type":"Source","creator":"Fernando, C.; Banarse, D.; Michalewski, H.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2309.16797","grade":"secondary","title":"Promptbreeder: Self-Referential Self-Improvement Via Prompt Evolution","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/#source-3","@type":"Source","creator":"DSPy","date":"2025","dcterms:source":"https://dspy.ai/current/api/optimizers/GEPA/overview/","grade":"secondary","title":"GEPA Overview","verifiedOn":"2026-11-18T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","@type":["https://patterns.agenticsystemcore.com/ns/operations-reliability#Safeguard","Concept"],"altLabel":[{"@language":"en","@value":"Retry pattern (Azure Architecture Center)"},{"@language":"en","@value":"node retry policy (LangGraph)"},{"@language":"en","@value":"retry / fallback / graceful degradation"},{"@language":"en","@value":"transient-fault handling for agents"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Classify each failure, retry short faults with limits, switch route for lasting ones, and report reduced results honestly."},"https://patterns.agenticsystemcore.com/ns/operations-reliability#guardsAgainst":{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Exception Handling and Recovery"},"related":["https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/","https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/","https://patterns.agenticsystemcore.com/concepts/saga-for-agents/","https://patterns.agenticsystemcore.com/concepts/termination-conditions/","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"],"schema:additionalType":"policy","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-1","https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-2","https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-1","@type":"Source","creator":"Microsoft","date":"2024","dcterms:source":"https://learn.microsoft.com/en-us/azure/architecture/patterns/retry","grade":"primary","title":"Retry pattern","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-2","@type":"Source","creator":"Microsoft","date":"2026","dcterms:source":"https://learn.microsoft.com/en-us/azure/architecture/best-practices/transient-faults","grade":"secondary","title":"Transient fault handling","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-3","@type":"Source","creator":"LangChain","date":"2026","dcterms:source":"https://docs.langchain.com/oss/python/langgraph/use-graph-api","grade":"secondary","title":"Build checklist for the Graph API","verifiedOn":"2026-11-18T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/generative-agents/","@type":"Concept","altLabel":[{"@language":"en","@value":"Smallville agents"},{"@language":"en","@value":"believable proxies of human behavior"},{"@language":"en","@value":"interactive simulacra of human behavior"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"A simulated character with a full memory record, reflection over it, and plans drawn from both, so it stays consistent over days."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Generative Agents"},"related":["https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/","https://patterns.agenticsystemcore.com/concepts/skill-library/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-1","https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-1","@type":"Source","creator":"Park, J. S.; O'Brien, J. C.; Cai, C. J.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2304.03442","grade":"primary","title":"Generative Agents: Interactive Simulacra of Human Behavior","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-2","@type":"Source","creator":"Miller, K.","date":"2023","dcterms:source":"https://hai.stanford.edu/news/computational-agents-exhibit-believable-humanlike-behavior","grade":"secondary","title":"Computational Agents Exhibit Believable Humanlike Behavior","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/","@type":"Concept","altLabel":[{"@language":"en","@value":"BDD scenarios for agents"},{"@language":"en","@value":"Gherkin-style eval scenarios"},{"@language":"en","@value":"acceptance criteria as agent tests"},{"@language":"en","@value":"specification by example for evals"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Write agent requirements as Given/When/Then scenarios and run each as a repeatable evaluation."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Given/When/Then Agent Specs"},"related":["https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-1","https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-2","https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-3","https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-1","@type":"Source","creator":"North, D.","date":"2006","dcterms:source":"https://dannorth.net/blog/introducing-bdd/","grade":"primary","title":"Introducing BDD","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-2","@type":"Source","creator":"Cucumber","date":"2026","dcterms:source":"https://cucumber.io/docs/gherkin/reference/","grade":"secondary","title":"Gherkin Reference","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-3","@type":"Source","creator":"Xia, B.; Lu, Q.; Zhu, L.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2411.13768","grade":"secondary","title":"Evaluation-Driven Development and Operations of LLM Agents: A Process Model and Reference Architecture","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/#source-4","@type":"Source","creator":"promptfoo","date":"2026","dcterms:source":"https://www.promptfoo.dev/docs/configuration/scenarios/","grade":"secondary","title":"Scenarios","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/","@type":"Concept","altLabel":[{"@language":"en","@value":"GWT-style agent architecture"},{"@language":"en","@value":"LIDA-style cognitive cycle"},{"@language":"en","@value":"attention bottleneck + broadcast"},{"@language":"en","@value":"global workspace broadcast"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Specialist modules share one workspace, with specialised processors around it, as in Global Workspace Theory."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Global Workspace as Blackboard"},"related":["https://patterns.agenticsystemcore.com/concepts/blackboard/","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-1","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-2","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-3","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-1","@type":"Source","creator":"Baars, B. J.","date":"2005","dcterms:source":"https://pubmed.ncbi.nlm.nih.gov/16186014/","grade":"primary","title":"Global workspace theory of consciousness: toward a cognitive neuroscience of human experience","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-2","@type":"Source","creator":"Dehaene, S.; Kerszberg, M.; Changeux, J.-P.","date":"1998","dcterms:source":"https://pmc.ncbi.nlm.nih.gov/articles/PMC24407/","grade":"secondary","title":"A neuronal model of a global workspace in effortful cognitive tasks","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-3","@type":"Source","creator":"Baars, B. J.; Franklin, S.","date":"2007","dcterms:source":"https://pubmed.ncbi.nlm.nih.gov/17998071/","grade":"secondary","title":"An architectural model of conscious and unconscious brain functions: Global Workspace Theory and IDA","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-4","@type":"Source","creator":"Goldstein, S.; Kirk-Giannini, C. D.","date":"2024","dcterms:source":"https://arxiv.org/abs/2410.11407","grade":"secondary","title":"A Case for AI Consciousness: Language Agents and Global Workspace Theory","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","@type":"Concept","altLabel":[{"@language":"en","@value":"MAPE-K for agents"},{"@language":"en","@value":"autonomic control loop"},{"@language":"en","@value":"expected_output + guardrail (CrewAI)"},{"@language":"en","@value":"goal-progress monitoring"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Give an agent a goal with checkable criteria, then monitor its progress and decide to continue, re-plan or stop."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Goal Setting and Monitoring"},"related":["https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/","https://patterns.agenticsystemcore.com/concepts/specification-gaming/","https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/","https://patterns.agenticsystemcore.com/concepts/termination-conditions/","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-1","https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-1","@type":"Source","creator":"Zhang, Z.; Yang, F.; Qin, X.; et al.","date":"2024","dcterms:source":"https://arxiv.org/html/2407.14402v1","grade":"primary","title":"The Vision of Autonomic Computing: Can LLMs Make It a Reality?","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-2","@type":"Source","creator":"CrewAI","date":"2026","dcterms:source":"https://docs.crewai.com/en/concepts/tasks","grade":"secondary","title":"Tasks","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/","@type":"Concept","altLabel":[{"@language":"en","@value":"conformance test (ADK)"},{"@language":"en","@value":"evalset regression (ADK)"},{"@language":"en","@value":"golden trajectory tests"},{"@language":"en","@value":"recorded-session eval cases"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Store a known-good agent run as a test case and replay it on each change; Google's ADK and Anthropic describe tolerant ways to compare the results."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Golden Trajectories and Snapshot Tests"},"related":["https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/","https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/","https://patterns.agenticsystemcore.com/concepts/pass-hat-k/","https://patterns.agenticsystemcore.com/concepts/record-replay-cassettes/","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/#source-1","https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/#source-1","@type":"Source","creator":"Google","date":"2026","dcterms:source":"https://adk.dev/evaluate/","grade":"primary","title":"Why evaluate agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/#source-2","@type":"Source","creator":"Grace, M.; Hadfield, J.; Olivares, R.; et al.","date":"2026","dcterms:source":"https://www.anthropic.com/research/demystifying-evals-for-ai-agents","grade":"secondary","title":"Demystifying evals for AI agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/","@type":"Concept","altLabel":[{"@language":"en","@value":"GoT (Besta et al.)"},{"@language":"en","@value":"aggregating thoughts"},{"@language":"en","@value":"graph-of-operations prompting"},{"@language":"en","@value":"thoughts as vertices, dependencies as edges"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Model LLM reasoning as a graph of thoughts and dependencies, so thoughts can be combined and refined, not only branched."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Graph of Thoughts"},"related":["https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/","https://patterns.agenticsystemcore.com/concepts/state-graph-agents/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/#source-1","https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/#source-2","https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/#source-1","@type":"Source","creator":"Besta, M.; Blach, N.; Kubicek, A.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2308.09687","grade":"primary","title":"Graph of Thoughts: Solving Elaborate Problems with Large Language Models","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/#source-2","@type":"Source","creator":"Besta, M.; Blach, N.; Kubicek, A.; et al.","date":"2024","dcterms:source":"https://arxiv.org/html/2308.09687v4","grade":"secondary","title":"Graph of Thoughts: Solving Elaborate Problems with Large Language Models (full text, v4)","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/#source-3","@type":"Source","creator":"Yao, S.; Yu, D.; Zhao, J.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2305.10601","grade":"secondary","title":"Tree of Thoughts: Deliberate Problem Solving with Large Language Models","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"An agent works on its own branch and cannot approve or merge; a named human decides what reaches the main branch."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Human-Only Merge Gate"},"related":["https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/","https://patterns.agenticsystemcore.com/concepts/plan-approval-gate/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-1","https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-1","@type":"Source","creator":"GitHub","date":"2026","dcterms:source":"https://docs.github.com/en/copilot/concepts/security-governance-and-network-settings/risks-and-mitigations","grade":"primary","title":"Risks and mitigations for GitHub Copilot cloud agent","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-2","@type":"Source","creator":"Prifti, Y.; De Meo, P.; Provetti, A.","date":"2026","dcterms:source":"https://arxiv.org/abs/2606.20615","grade":"secondary","title":"Specifying AI-SDLC Processes: A Protocol Language for Human-Agent Boundaries","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/","@type":"Concept","altLabel":[{"@language":"en","@value":"Idempotency-Key header (Stripe)"},{"@language":"en","@value":"duplicate-action suppression"},{"@language":"en","@value":"idempotent activities (Temporal)"},{"@language":"en","@value":"safe-retry keys"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Attach a stable idempotency key to each side-effecting call so a retried or replayed request is executed once, as Stripe and Temporal describe."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Idempotency Keys for Agent Actions"},"related":["https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","https://patterns.agenticsystemcore.com/concepts/record-replay-cassettes/","https://patterns.agenticsystemcore.com/concepts/saga-for-agents/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/#source-1","https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/#source-1","@type":"Source","creator":"Stripe","date":"2026","dcterms:source":"https://docs.stripe.com/api/idempotent_requests","grade":"primary","title":"Idempotent requests","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/#source-2","@type":"Source","creator":"Temporal","date":"2026","dcterms:source":"https://docs.temporal.io/activity-definition","grade":"secondary","title":"Activity Definition","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/","@type":"Concept","altLabel":[{"@language":"en","@value":"append-only action record"},{"@language":"en","@value":"hash-chained audit"},{"@language":"en","@value":"session-log provenance"}],"created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"An append-only, hash-linked record of every important agent action, so what happened can be rebuilt and checked."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Tamper-Evident Agent Audit Log"},"related":["https://patterns.agenticsystemcore.com/concepts/agent-identity-scoped-credentials/","https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/","https://patterns.agenticsystemcore.com/concepts/meaningful-human-control/","https://patterns.agenticsystemcore.com/concepts/memory-context-poisoning/","https://patterns.agenticsystemcore.com/concepts/owasp-agentic-top-10/","https://patterns.agenticsystemcore.com/concepts/plan-approval-gate/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-1","https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-2","https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-1","@type":"Source","creator":"Haber, S.; Stornetta, W. S.","date":"1991","dcterms:source":"https://doi.org/10.1007/BF00196791","grade":"primary","title":"How to time-stamp a digital document","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-2","@type":"Source","creator":"OWASP Gen AI Security Project","date":"2025","dcterms:source":"https://genai.owasp.org/resource/agentic-ai-threats-and-mitigations/","grade":"secondary","title":"Agentic AI – Threats and Mitigations","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-3","@type":"Source","creator":"GitHub","date":"2026","dcterms:source":"https://github.blog/changelog/2026-03-20-trace-any-copilot-coding-agent-commit-to-its-session-logs/","grade":"secondary","title":"Trace any Copilot coding agent commit to its session logs","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/judge-calibration/","@type":"Concept","altLabel":[{"@language":"en","@value":"judge agreement with humans"},{"@language":"en","@value":"judge alignment rate"},{"@language":"en","@value":"position, verbosity and self-enhancement bias audit"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Measure an automated judge against human labels before trusting its verdicts, and audit it for position, verbosity and self-enhancement bias."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Judge Calibration"},"related":["https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/","https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/judge-calibration/#source-1","https://patterns.agenticsystemcore.com/concepts/judge-calibration/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/judge-calibration/#source-1","@type":"Source","creator":"Zheng, L.; Chiang, W.; Sheng, Y.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2306.05685","grade":"primary","title":"Judging LLM-as-a-Judge with MT-Bench and Chatbot Arena","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/judge-calibration/#source-2","@type":"Source","creator":"Zhuge, M.; Zhao, C.; Ashley, D.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2410.10934","grade":"secondary","title":"Agent-as-a-Judge: Evaluate Agents with Agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/keep-cards-short/","@type":"Concept","created":"2026-11-18T00:00:00Z","decides":"https://patterns.agenticsystemcore.com/concepts/card-format/","definition":{"@language":"en","@value":"The decision that each card says one thing under each heading, in one sentence."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"decision","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"Keep cards short"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/meaningful-human-control/","@type":"Concept","altLabel":[{"@language":"en","@value":"MHC"},{"@language":"en","@value":"guidance control over autonomous systems"},{"@language":"en","@value":"human oversight by design"},{"@language":"en","@value":"tracking and tracing conditions"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Two conditions for real human control: the system responds to relevant human reasons, and its actions trace to a person who understands it."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Meaningful Human Control"},"r