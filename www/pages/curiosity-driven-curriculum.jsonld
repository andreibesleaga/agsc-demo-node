{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/","@type":"Concept","altLabel":[{"@language":"en","@value":"automatic curriculum from novelty"},{"@language":"en","@value":"curiosity reward for agents"},{"@language":"en","@value":"in-context novelty search"},{"@language":"en","@value":"intrinsic-motivation task proposal"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Choose an agent's next task from novelty or learning progress instead of a fixed task list, as in Voyager's automatic curriculum."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Curiosity-Driven Curriculum"},"related":["https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","https://patterns.agenticsystemcore.com/concepts/skill-library/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-1","https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-2","https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-3","https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/curiosity-driven-curriculum/#source-1","@type":"Source","creator":"Oudeyer, P.-Y.; Kaplan, F.","date":"2007","dcterms:source":"https://www.frontiersin.org/journals/neurorobotics/articles/10.3389/n