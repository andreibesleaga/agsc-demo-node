{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/","@type":"Concept","altLabel":[{"@language":"en","@value":"GWT-style agent architecture"},{"@language":"en","@value":"LIDA-style cognitive cycle"},{"@language":"en","@value":"attention bottleneck + broadcast"},{"@language":"en","@value":"global workspace broadcast"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Specialist modules share one workspace, with specialised processors around it, as in Global Workspace Theory."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Global Workspace as Blackboard"},"related":["https://patterns.agenticsystemcore.com/concepts/blackboard/","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-1","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-2","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-3","https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/global-workspace-blackboard/#source-1","@type":"Source","creator":"Baars, B. J.","date":"2005","dcterms:source":"https://pubmed.ncbi.nlm.nih.gov/16186014/","grade":"primary","title":"Global workspace theory of consciousness: t