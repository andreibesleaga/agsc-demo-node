# Copy to `.env` (which is never committed — see .gitignore) and edit.
#
# Only names matching AGSC_[A-Z0-9_]+ are honoured; every other assignment in the
# file is ignored and its NAME is reported, never its value (AGSC-01-37). A name
# set here is overridden by the same name in the process environment, and by a
# command-line flag above that (AGSC-09-09).
#
# This node needs none of these to build. They are the knobs that exist.

# The build instant, as seconds since the epoch. Setting it makes every emission
# byte-reproducible; leaving it unset warns and uses 0 (AGSC-04-09).
# SOURCE_DATE_EPOCH=1774051200

# Where the build writes (default `www`, AGSC-01-19).
# AGSC_BUILD_OUT=www

# `public` or `restricted` — whether the emitted surfaces are open to any origin
# (AGSC-11-01/11-03).
# AGSC_VISIBILITY=public

# The review lane is lint-only unless this flag is set, and no model is reachable
# from it either way (AGSC-08-27).
# AGSC_FEATURE_LLM_REVIEW=false

# A model endpoint, only if a lane that calls one is ever enabled. A credential is
# read from the environment and is never written into any emitted file.
# AGSC_MODEL_BASE_URL=
# AGSC_MODEL_API_KEY=
