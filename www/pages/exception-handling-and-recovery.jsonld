{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","@type":["https://patterns.agenticsystemcore.com/ns/operations-reliability#Safeguard","Concept"],"altLabel":[{"@language":"en","@value":"Retry pattern (Azure Architecture Center)"},{"@language":"en","@value":"node retry policy (LangGraph)"},{"@language":"en","@value":"retry / fallback / graceful degradation"},{"@language":"en","@value":"transient-fault handling for agents"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Classify each failure, retry short faults with limits, switch route for lasting ones, and report reduced results honestly."},"https://patterns.agenticsystemcore.com/ns/operations-reliability#guardsAgainst":{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Exception Handling and Recovery"},"related":["https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/","https://patterns.agenticsystemcore.com/concepts/idempotent-agent-actions/","https://patterns.agenticsystemcore.com/concepts/saga-for-agents/","https://patterns.agenticsystemcore.com/concepts/termination-conditions/","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"],"schema:additionalType":"policy","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-1","https://patterns.agenticsystemcore.com/concepts/exception-handling-and-rec