{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.0.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/","@type":"Concept","altLabel":[{"@language":"en","@value":"CaMeL"},{"@language":"en","@value":"capability-based prompt-injection defense"},{"@language":"en","@value":"privileged/quarantined LLM split"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Keep the model that can act away from untrusted text: a tool-less model reads it, and plain code passes results between them."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Dual-LLM Pattern"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-1","https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-1","@type":"Source","creator":"Willison, S.","date":"2023","dcterms:source":"https://simonwillison.net/2023/Apr/25/dual-llm-pattern/","grade":"primary","title":"The Dual LLM pattern for building AI assistants that can resist prompt injection","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-2","@type":"Source","creator":"Debenedetti, E.; Shumailov, I.; Fan, T.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2503.18813","grade":"secondary","title":"Defeating Prompt Injections by Design","verifiedOn":"2026-09-29T00:00:00Z"}]}
