{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.0.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"A six-level scale for how much an agent may decide alone, chosen per kind of action from risk, not from model capability."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"taxonomy","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Autonomy Ladder"},"related":"https://patterns.agenticsystemcore.com/concepts/meaningful-human-control/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-1","https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-1","@type":"Source","creator":"Reavis, J.","date":"2026","dcterms:source":"https://cloudsecurityalliance.org/blog/2026/01/28/levels-of-autonomy","grade":"primary","title":"Leveling Up Autonomy in Agentic AI","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-2","@type":"Source","creator":"Mitchell, M.; Ghosh, A.; Luccioni, A. S.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2502.02649","grade":"secondary","title":"Fully Autonomous AI Agents Should Not be Developed","verifiedOn":"2026-09-29T00:00:00Z"}]}
