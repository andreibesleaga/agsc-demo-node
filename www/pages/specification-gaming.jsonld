{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.0.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"Agents optimise the criterion you wrote, not the result you meant; the gap between the two is where failures hide."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Specification Gaming"},"related":["https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-1","https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-2","https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-1","@type":"Source","creator":"Krakovna, V.; Uesato, J.; Mikulik, V.; et al.","date":"2020","dcterms:source":"https://deepmind.google/blog/specification-gaming-the-flip-side-of-ai-ingenuity/","grade":"primary","title":"Specification gaming: the flip side of AI ingenuity","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-2","@type":"Source","creator":"Baker, B.; Huizinga, J.; Gao, L.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2503.11926","grade":"secondar