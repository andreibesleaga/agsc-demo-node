le":"Saga for Agent Workflows"},{"description":"Building software with agents through phases, approval gates and reviews.","slug":"sdlc","title":"Agentic SDLC"},{"description":"Threats to agents, and the designs that defend against them.","slug":"security","title":"Security"},{"cluster":"memory-cognition","description":"Store verified procedures so an agent's skills build up across tasks instead of being rediscovered every run.","slug":"skill-library","title":"Skill-Library Compounding"},{"cluster":"specs","description":"Agents optimise the criterion you wrote, not the result you meant; the gap between the two is where failures hide.","slug":"specification-gaming","title":"Specification Gaming"},{"description":"How to state what an agent should do when its behaviour is not fully predictable.","slug":"specs","title":"Specs & Requirements"},{"cluster":"protocols","description":"A well-known URI where a system publishes its energy and carbon figures, and reads its peers' figures as input to its decisions.","slug":"sustainability-signal-plane","title":"Sustainability Signal Plane"},{"description":"Ways for several agents to work together, such as a shared workspace or a hierarchy.","slug":"topologies","title":"Multi-Agent Topologies"},{"cluster":"evaluation-testing","description":"Grade the end state an agent produced and the path it took as two separate questions, each with a suitable grader.","slug":"trajectory-vs-outcome-evals","title":"Trajectory and Outcome Evaluation"},{"cluster":"antipatterns","description":"An agent loop with no step limit, no budget and no independent exit test runs until money, patience or the platform stops it.","slug":"unbounded-agent-loops","title":"Unbounded Loops"},{"cluster":"future","description":"Open question: can weaker judges, human or model, reliably oversee agents stronger than themselves? What is known and what is not.","slug":"weak-to-strong-oversight","title":"Weak-to-Strong Oversight"}],"terms":{"10":[9,23],"100":[23],"14":[19