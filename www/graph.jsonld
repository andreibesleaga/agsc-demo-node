obotics-and-ai/articles/10.3389/frobt.2018.00015/full","grade":"primary","title":"Meaningful Human Control over Autonomous Systems: A Philosophical Account","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/meaningful-human-control/#source-2","@type":"Source","creator":"European Parliament; Council of the European Union","date":"2024","dcterms:source":"https://artificialintelligenceact.eu/article/14/","grade":"secondary","title":"Article 14: Human Oversight","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/","@type":"Concept","altLabel":[{"@language":"en","@value":"know-what-you-know signalling"},{"@language":"en","@value":"meta-level control loop"},{"@language":"en","@value":"metacognitive monitoring"},{"@language":"en","@value":"monitor-generate-verify (MGV)"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"A meta level watches how sure the agent is while it works and decides to continue, retry or abstain."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Metacognitive Monitoring and Control"},"related":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-1","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-2","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-3","https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-1","@type":"Source","creator":"Flavell, J. H.","date":"1979","dcterms:source":"https://doi.org/10.1037/0003-066X.34.10.906","grade":"primary","title":"Metacognition and Cognitive Monitoring: A New Area of Cognitive-Developmental Inquiry","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-2","@type":"Source","creator":"Nelson, T. O.; Narens, L.","date":"1990","dcterms:source":"https://doi.org/10.1016/S0079-7421(08)60053-5","grade":"secondary","title":"Metamemory: A Theoretical Framework and New Findings","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-3","@type":"Source","creator":"Oh, N.; Gobet, F.","date":"2025","dcterms:source":"https://arxiv.org/abs/2511.04341","grade":"secondary","title":"Monitor-Generate-Verify (MGV): Formalising Metacognitive Theory for Language Model Reasoning","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/#source-4","@type":"Source","creator":"Kadavath, S.; Conerly, T.; Askell, A.; et al.","date":"2022","dcterms:source":"https://arxiv.org/abs/2207.05221","grade":"secondary","title":"Language Models (Mostly) Know What They Know","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/owasp-agentic-top-10/","@type":"Concept","altLabel":[{"@language":"en","@value":"ASI01–ASI10"},{"@language":"en","@value":"OWASP agentic security risks"}],"created":"2026-08-15T00:00:00Z","definition":{"@language":"en","@value":"OWASP's list of ten security risks for agents that act, a shared vocabulary for threat models and security reviews."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"taxonomy","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"OWASP Top 10 for Agentic Applications"},"schema:license":"LicenseRef-AgenticSystemCore-Content-U