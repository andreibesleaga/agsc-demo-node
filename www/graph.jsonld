s/blackboard/","https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/"],"operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Multi-Agent Topologies"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/clusters/upkeep/","@type":"Cluster","created":"2026-11-18T00:00:00Z","definition":{"@language":"en","@value":"The node's own work on one board: the decision on card length, the card format, the gate and the open tasks."},"member":["https://patterns.agenticsystemcore.com/concepts/card-format/","https://patterns.agenticsystemcore.com/concepts/keep-cards-short/","https://patterns.agenticsystemcore.com/concepts/task-recheck-sources/","https://patterns.agenticsystemcore.com/concepts/task-report-a-broken-link/","https://patterns.agenticsystemcore.com/gates/publish-gate/","https://patterns.agenticsystemcore.com/procedures/check-a-card-against-its-sources/"],"model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"Upkeep"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/","@type":"Concept","altLabel":[{"@language":"en","@value":"AFlow (MCTS over workflows)"},{"@language":"en","@value":"Multi-Agent System Search (MASS)"},{"@language":"en","@value":"automated workflow search"},{"@language":"en","@value":"language agents as optimizable graphs (GPTSwarm)"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Treat an agent workflow as a graph of nodes, edges and prompts, and search that space with an evaluator, as GPTSwarm, AFlow and MASS do."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Agent-Graph Optimization"},"related":["https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/","https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/","https://patterns.agenticsystemcore.com/concepts/state-graph-agents/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-1","https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-2","https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-1","@type":"Source","creator":"Zhuge, M.; Wang, W.; Kirsch, L.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2402.16823","grade":"primary","title":"Language Agents as Optimizable Graphs","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-2","@type":"Source","creator":"Zhang, J.; Xiang, J.; Yu, Z.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2410.10762","grade":"secondary","title":"AFlow: Automating Agentic Workflow Generation","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-3","@type":"Source","creator":"Zhou, H.; Wan, X.; Sun, R.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2502.02533","grade":"secondary","title":"Multi-Agent Design: Optimizing Agents with Better Prompts and Topologies","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agent-identity-scoped-credentials/","@type":"Concept","altLabel":[{"@language":"en","@value":"delegation-chain scoping"},{"@language":"en","