{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/","@type":"Concept","altLabel":[{"@language":"en","@value":"debate with judge (Liang et al.)"},{"@language":"en","@value":"debate-based cooperation (Liu et al.)"},{"@language":"en","@value":"multiagent debate (Du et al.)"},{"@language":"en","@value":"tit-for-tat debate"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Several model instances propose answers, read one another's responses and revise over rounds; a judge or convergence ends the debate."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Multi-Agent Debate"},"related":["https://patterns.agenticsystemcore.com/concepts/blackboard/","https://patterns.agenticsystemcore.com/concepts/parallelization/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/#source-1","https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/#source-2","https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/#source-1","@type":"Source","creator":"Du, Y.; Li, S.; Torralba, A.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2305.14325","grade":"primary","title":"Improving Factuality and Reasoning in Language Models through Multiagent Debate","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/#source-2","@type":"Source","creator":"Liang, T.; He, Z.; Jiao, W.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2305.19118","grade":"secondary","title":"Encouraging Divergent Thinking in Large Language Models through Multi-Agent Debate","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/multi-agent-debate/#source-3","@type":"Source","creator":"Liu, Y.; Lo, S. K.; Lu, Q.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2405.10467","grade":"secondary","title":"Agent Design Pattern Catalogue: A Collection of Architectural Patterns for Foundation Model based Agents","verifiedOn":"2026-11-12T00:00:00Z"}]}
