<https://patterns.agenticsystemcore.com/concepts/agent-identity-scoped-credentials/> dcterms:created "2026-08-16T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-11-18T00:00:00Z"^^xsd:dateTime ;
    a asc:Concept ;
    skos:altLabel "delegation-chain scoping"@en , "non-human identity per agent"@en , "task-scoped agent credentials"@en ;
    skos:definition "Give each agent its own identity and short-lived, task-scoped credentials so delegation narrows authority and actions are attributable."@en ;
    skos:inScheme <https://patterns.agenticsystemcore.com/> ;
    skos:prefLabel "Agent Identity and Scoped Credentials"@en ;
    skos:related <https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/> , <https://patterns.agenticsystemcore.com/concepts/owasp-agentic-top-10/> ;
    schema:license "LicenseRef-AgenticSystemCore-Content-Use-1.0" ;
    schema:usageInfo "LicenseRef-AgenticSystemCore-Content-Use-1.0" ;
    asc:kind "pattern" ;
    asc:operator "human:andreibesleaga" ;
    asc:origin "imported" ;
