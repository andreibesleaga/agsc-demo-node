026","dcterms:source":"https://carbontxt.org","grade":"secondary","title":"carbon.txt","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-3","@type":"Source","creator":"Green Software Foundation","date":"2025","dcterms:source":"https://github.com/Green-Software-Foundation/real-time-cloud","grade":"secondary","title":"Real Time Energy and Carbon Standards for Cloud Providers","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-4","@type":"Source","creator":"Andrei N. Besleaga","date":"2026","dcterms:source":"https://doi.org/10.5281/zenodo.22056634","grade":"secondary","title":"The Cybernetic Sustainability Loop: Governed Agentic Systems on a Sustainability Data Plane — evaluation package","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/task-recheck-sources/","@type":"Concept","created":"2026-11-18T00:00:00Z","definition":{"@language":"en","@value":"Open each source of one card, confirm that it still says what the card says, and record the date."},"implements":"https://patterns.agenticsystemcore.com/concepts/card-format/","inScheme":"https://patterns.agenticsystemcore.com/","kind":"task","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"Re-check the sources of a card"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","taskState":"TASK_STATE_SUBMITTED","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/task-report-a-broken-link/","@type":"Concept","created":"2026-11-18T00:00:00Z","definition":{"@language":"en","@value":"Tell the node about a source address that fails, with the name of the card that cites it."},"implements":"https://patterns.agenticsystemcore.com/concepts/card-format/","inScheme":"https://patterns.agenticsystemcore.com/","kind":"task","model":"Claude (Anthropic)","operator":"human:andreibesleaga","origin":"ai-assisted","prefLabel":{"@language":"en","@value":"Report a source that no longer answers"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","taskState":"TASK_STATE_SUBMITTED","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/termination-conditions/","@type":"Concept","altLabel":[{"@language":"en","@value":"exit conditions"},{"@language":"en","@value":"max_turns (OpenAI Agents SDK)"},{"@language":"en","@value":"stopping conditions (Anthropic)"},{"@language":"en","@value":"turn limits"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Define in advance each way an agent loop ends, such as a final answer, a turn limit, or a pause for human input."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Termination and Exit Conditions"},"related":["https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","https://patterns.agenticsystemcore.com/concepts/safe-interruptibility/","https://patterns.agenticsystemcore.com/concepts/thinking-budget-control/","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/termination-conditions/#source-1","https://patterns.agenticsystemcore.com/concepts/termination-conditions/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/termination-conditions/#source-1","@type":"Source","creator":"Anthropic","date":"2024","dcter