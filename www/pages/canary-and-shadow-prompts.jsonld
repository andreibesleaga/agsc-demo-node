{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/","@type":"Concept","altLabel":[{"@language":"en","@value":"canary release for prompts"},{"@language":"en","@value":"prompt canary label (Langfuse)"},{"@language":"en","@value":"shadow testing (Statsig)"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Release a changed prompt or model to a small share of live traffic, or to a copy of it, and compare it with the current version before promoting."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Canary and Shadow Deployment for Prompts and Models"},"related":["https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/","https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/","https://patterns.agenticsystemcore.com/concepts/shadow-mode-rollout/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-1","https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-2","https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-1","@type":"Source","creator":"Warner, A.; Davidovič, Š.; Hidalgo, A.; et al.","date":"2018","dcterms:source":"https://sre.google/workbook/canarying-releases/","grade":"primary","title":"Canarying Releases","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-2","@type":"Source","creator":"Langfuse","date":"2026","dcterms:source":"https://langfuse.com/resources/engineering/prompt-cicd","grade":"secondary","title":"Prompt CI/CD: version, gate, and roll out prompts like code","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/canary-and-shadow-prompts/#source-3","@type":"Source","creator":"Statsig","date":"2025","dcterms:source":"https://www.statsig.com/perspectives/shadow-testing-ai-model-evaluation","grade":"secondary","title":"Shadow Testing for AI: How to Evaluate Models Without Affecting Users","verifiedOn":"2026-11-12T00:00:00Z"}]}
