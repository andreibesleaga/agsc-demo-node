ce":"https://platform.claude.com/docs/en/build-with-claude/effort","grade":"primary","title":"Effort","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/thinking-budget-control/#source-2","@type":"Source","creator":"Anthropic","date":"2026","dcterms:source":"https://platform.claude.com/docs/en/build-with-claude/extended-thinking","grade":"secondary","title":"Extended thinking","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/thinking-budget-control/#source-3","@type":"Source","creator":"OpenAI","date":"2026","dcterms:source":"https://developers.openai.com/api/docs/guides/reasoning","grade":"secondary","title":"Reasoning models","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/thinking-budget-control/#source-4","@type":"Source","creator":"Google","date":"2026","dcterms:source":"https://aistudio.google.com/docs/thinking","grade":"secondary","title":"Gemini thinking","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/thinking-budget-control/#source-5","@type":"Source","creator":"Chen, X.; Xu, J.; Liang, T.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2412.21187","grade":"secondary","title":"Do NOT Think That Much for 2+3=? On the Overthinking of o1-Like LLMs","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/","@type":"Concept","altLabel":[{"@language":"en","@value":"final-state grading"},{"@language":"en","@value":"tool-trajectory match"},{"@language":"en","@value":"trajectory evals"},{"@language":"en","@value":"transcript grading"}],"created":"2026-08-15T00:00:00Z","definition":{"@language":"en","@value":"Grade the end state an agent produced and the path it took as two separate questions, each with a suitable grader."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Trajectory and Outcome Evaluation"},"related":["https://patterns.agenticsystemcore.com/concepts/error-analysis-coding/","https://patterns.agenticsystemcore.com/concepts/given-when-then-agent-specs/","https://patterns.agenticsystemcore.com/concepts/golden-trajectory-snapshots/","https://patterns.agenticsystemcore.com/concepts/judge-calibration/","https://patterns.agenticsystemcore.com/concepts/pass-hat-k/","https://patterns.agenticsystemcore.com/concepts/resolution-rate-metrics/","https://patterns.agenticsystemcore.com/concepts/retrieval-evaluation/","https://patterns.agenticsystemcore.com/concepts/shadow-mode-rollout/","https://patterns.agenticsystemcore.com/concepts/specification-gaming/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-1","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-2","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-1","@type":"Source","creator":"Grace, M.; Hadfield, J.; Olivares, R.; et al.","date":"2026","dcterms:source":"https://www.anthropic.com/research/demystifying-evals-for-ai-agents","grade":"primary","title":"Demystifying evals for AI agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-2","@type":"Source","creator":"Google","date":"2026","dcterms:source":"https://adk.dev/evaluate/","grade":"secondary","title":"Why evaluate agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-3","@type":"Source","creator":"Huyen, C.","date":"2025","dcterms:source":"https://huyenchip.com/2025/01/07/agents.html","grade":"secondary","title":"Agents","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/","@type":["https://patterns.agenticsystemcore.com/ns/antipatterns#FailureMode","Concept"],"altLabel":[{"@language":"en","@value":"infinite loop"},{"@language":"en","@value":"no stopping condition"},{"@language":"en","@value":"runaway agent loop"},{"@language":"en","@value":"unbounded agent loop"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"An agent loop with no step limit, no budget and no independent exit test runs until money, patience or the platform stops it."},"https://patterns.agenticsystemcore.com/ns/antipatterns#guardedBy":{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/"},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Unbounded Loops"},"related":["https://patterns.agenticsystemcore.com/concepts/bulkhead-isolation/","https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","https://patterns.agenticsystemcore.com/concepts/owasp-agentic-top-10/","https://patterns.agenticsystemcore.com/concepts/termination-conditions/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-1","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-2","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-1","@type":"Sour