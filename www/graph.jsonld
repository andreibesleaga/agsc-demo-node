:"https://patterns.agenticsystemcore.com/concepts/plan-approval-gate/","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Agentic SDLC"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/clusters/security/","@type":"Cluster","created":"2026-03-21T00:00:00Z","definition":{"@language":"en","@value":"Threats to agents, and the designs that defend against them."},"member":["https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/","https://patterns.agenticsystemcore.com/concepts/owasp-agentic-top-10/"],"operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Security"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/clusters/specs/","@type":"Cluster","created":"2026-03-21T00:00:00Z","definition":{"@language":"en","@value":"How to state what an agent should do when its behaviour is not fully predictable."},"member":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Specs & Requirements"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/clusters/topologies/","@type":"Cluster","created":"2026-03-21T00:00:00Z","definition":{"@language":"en","@value":"Ways for several agents to work together, such as a shared workspace or a hierarchy."},"member":"https://patterns.agenticsystemcore.com/concepts/blackboard/","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Multi-Agent Topologies"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/","@type":"Concept","altLabel":[{"@language":"en","@value":"context-isolated subagent"},{"@language":"en","@value":"subagent (Claude Code)"},{"@language":"en","@value":"tool-agents (OpenAI Agents SDK)"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Wrap a specialist agent as a tool, so a calling agent can hand it one bounded task and keep control."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Agents as Tools"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-1","https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-2","https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-1","@type":"Source","creator":"OpenAI","date":"2025","dcterms:source":"https://openai.github.io/openai-agents-python/tools/#agents-as-tools","grade":"primary","title":"Tools","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-2","@type":"Source","creator":"OpenAI","date":"2025","dcterms:source":"https://openai.github.io/openai-agents-python/multi_agent/","grade":"secondary","title":"Agent orchestration","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/agents-as-tools/#source-3","@type":"Source","creator":"Anthropic","date":"2026","dcterms:source":"https://code.claude.com/docs/en/sub-agents","grade":"secondary","title":"Create custom subagents","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"A six-level scale for how much an agent may decide alone, chosen per kind of action from risk, not from model capability."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"taxonomy","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Autonomy Ladder"},"related":"https://patterns.agenticsystemcore.com/concepts/meaningful-human-control/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-1","https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-1","@type":"Source","creator":"Reavis, J.","date":"2026","dcterms:source":"https://cloudsecurityalliance.org/blog/2026/01/28/levels-of-autonomy","grade":"primary","title":"Leveling Up Autonomy in Agentic AI","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/autonomy-ladder/#source-2","@type":"Source","creator":"Mitchell, M.; Ghosh, A.; Luccioni, A. S.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2502.02649","grade":"secondary","title":"Fully Autonomous AI Agents Should Not be Developed","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/blackboard/","@type":"Concept","altLabel":[{"@language":"en","@value":"opportunistic problem solving"},{"@language":"en","@value":"shared workspace"}],"created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"Independent specialists work on one problem through a shared workspace; a control step picks who contributes next."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Blackboard"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/blackboard/#source-1","https://patterns.agenticsystemcore.com/concepts/blackboard/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/blackboard/#source-1","@type":"Source","creator":"Erman, L. D.; Hayes-Roth, F.; Lesser, V. R.; et al.","date":"1980","dcterms:source":"https://mas.cs.umass.edu/Documents/Erman_Hearsay80.pdf","grade":"primary","title":"The Hearsay-II Speech-Understanding System: Integrating Knowledge to Resolve Uncertainty","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/blackboard/#source-2","@type":"Source","creator":"Han, B.; Zhang, S.","date":"2025","dcterms:source":"https://arxiv.org/abs/2507.01701","grade":"secondary","title":"Exploring Advanced LLM Multi-Agent Systems Based on Blackboard Architecture","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"Split a question into parts, search them in parallel, combine the findings and check that every claim has a source."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Deep Research Loop"},"related":"https://patterns.agenticsystemcore.com/concepts/parallelization/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-1","https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-1","@type":"Source","creator":"Hadfield, J.; Zhang, B.; Lien, K.; et al.","date":"2025","dcterms:source":"https://www.anthropic.com/engineering/multi-agent-research-system","grade":"primary","title":"How we built our multi-agent research system","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-2","@type":"Source","creator":"Gottweis, J.; Natarajan, V.","date":"2025","dcterms:source":"https://research.google/blog/accelerating-scientific-breakthroughs-with-an-ai-co-scientist/","grade":"secondary","title":"Accelerating scientific breakthroughs with an AI co-scientist","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/","@type":"Concept","altLabel":[{"@language":"en","@value":"CaMeL"},{"@language":"en","@value":"capability-based prompt-injection defense"},{"@language":"en","@value":"privileged/quarantined LLM split"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"Keep the model that can act away from untrusted text: a tool-less model reads it, and plain code passes results between them."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Dual-LLM Pattern"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-1","https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-1","@type":"Source","creator":"Willison, S.","date":"2023","dcterms:source":"https://simonwillison.net/2023/Apr/25/dual-llm-pattern/","grade":"primary","title":"The Dual LLM pattern for building AI assistants that can resist prompt injection","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/#source-2","@type":"Source","creator":"Debenedetti, E.; Shumailov, I.; Fan, T.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2503.18813","grade":"secondary","title":"Defeating Prompt Injections by Design","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/","@type":"Concept","altLabel":[{"@language":"en","@value":"Retry pattern (Azure Architecture Center)"},{"@language":"en","@value":"node retry policy (LangGraph)"},{"@language":"en","@value":"retry / fallback / graceful degradation"},{"@language":"en","@value":"transient-fault handling for agents"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Classify each failure, retry short faults with limits, switch route for lasting ones, and report reduced results honestly."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Exception Handling and Recovery"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-1","https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-2","https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-1","@type":"Source","creator":"Microsoft","date":"2024","dcterms:source":"https://learn.microsoft.com/en-us/azure/architecture/patterns/retry","grade":"primary","title":"Retry pattern","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-2","@type":"Source","creator":"Microsoft","date":"2026","dcterms:source":"https://learn.microsoft.com/en-us/azure/architecture/best-practices/transient-faults","grade":"secondary","title":"Transient fault handling","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/exception-handling-and-recovery/#source-3","@type":"Source","creator":"LangChain","date":"2026","dcterms:source":"https://docs.langchain.com/oss/python/langgraph/use-graph-api","grade":"secondary","title":"Use the graph API","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/generative-agents/","@type":"Concept","altLabel":[{"@language":"en","@value":"Smallville agents"},{"@language":"en","@value":"believable proxies of human behavior"},{"@language":"en","@value":"interactive simulacra of human behavior"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"A simulated character with a full memory record, reflection over it, and plans drawn from both, so it stays consistent over days."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Generative Agents"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-1","https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-1","@type":"Source","creator":"Park, J. S.; O'Brien, J. C.; Cai, C. J.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2304.03442","grade":"primary","title":"Generative Agents: Interactive Simulacra of Human Behavior","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/generative-agents/#source-2","@type":"Source","creator":"Miller, K.","date":"2023","dcterms:source":"https://hai.stanford.edu/news/computational-agents-exhibit-believable-humanlike-behavior","grade":"secondary","title":"Computational Agents Exhibit Believable Humanlike Behavior","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","@type":"Concept","altLabel":[{"@language":"en","@value":"MAPE-K for agents"},{"@language":"en","@value":"autonomic control loop"},{"@language":"en","@value":"expected_output + guardrail (CrewAI)"},{"@language":"en","@value":"goal-progress monitoring"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Give an agent a goal with checkable criteria, then monitor its progress and decide to continue, re-plan or stop."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Goal Setting and Monitoring"},"related":["https://patterns.agenticsystemcore.com/concepts/metacognitive-monitoring/","https://patterns.agenticsystemcore.com/concepts/specification-gaming/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-1","https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-1","@type":"Source","creator":"Zhang, Z.; Yang, F.; Qin, X.; et al.","date":"2024","dcterms:source":"https://arxiv.org/html/2407.14402v1","grade":"primary","title":"The Vision of Autonomic Computing: Can LLMs Make It a Reality?","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/#source-2","@type":"Source","creator":"CrewAI","date":"2026","dcterms:source":"https://docs.crewai.com/en/concepts/tasks","grade":"secondary","title":"Tasks","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/","@type":"Concept","altLabel":[{"@language":"en","@value":"append-only action record"},{"@language":"en","@value":"hash-chained audit"},{"@language":"en","@value":"session-log provenance"}],"created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"An append-only, hash-linked record of every important agent action, so what happened can be rebuilt and checked."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Tamper-Evident Agent Audit Log"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-1","https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-2","https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-1","@type":"Source","creator":"Haber, S.; Stornetta, W. S.","date":"1991","dcterms:source":"https://doi.org/10.1007/BF00196791","grade":"primary","title":"How to time-stamp a digital document","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/#source-2","@type":"Source","creator":"OWASP Gen AI Security Pro