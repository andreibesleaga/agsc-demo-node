    a <https://patterns.agenticsystemcore.com/ns/antipatterns#FailureMode> , asc:Concept ;
    skos:altLabel "infinite loop"@en , "no stopping condition"@en , "runaway agent loop"@en , "unbounded agent loop"@en ;
