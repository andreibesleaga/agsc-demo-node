<https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/> dcterms:created "2026-08-18T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-11-18T00:00:00Z"^^xsd:dateTime ;
    a asc:Concept ;
    skos:altLabel "AFlow (MCTS over workflows)"@en , "Multi-Agent System Search (MASS)"@en , "automated workflow search"@en , "language agents as optimizable graphs (GPTSwarm)"@en ;
    skos:definition "Treat an agent workflow as a graph of nodes, edges and prompts, and search that space with an evaluator, as GPTSwarm, AFlow and MASS do."@en ;
    skos:inScheme <https://patterns.agenticsystemcore.com/> ;
    skos:prefLabel "Agent-Graph Optimization"@en ;
    skos:related <https://patterns.agenticsystemcore.com/concepts/evolutionary-prompt-search/> , <https://patterns.agenticsystemcore.com/concepts/graph-of-thoughts/> , <https://patterns.agenticsystemcore.com/concepts/state-graph-agents/> ;
    schema:license "LicenseRef-AgenticSystemCore-Content-Use-1.0" ;
    schema:usageInfo "LicenseRef-AgenticSystemCore-Content-Use-1.0" ;
    asc:kind "pattern" ;
    asc:operator "human:andreibesleaga" ;
    asc:origin "imported" ;
    asc:source <https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-1> , <https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-2> , <https://patterns.agenticsystemcore.com/concepts/agent-graph-optimization/#source-3> ;
    asc:status "stable" .

