{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.1.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"An agent works on its own branch and cannot approve or merge; a named human decides what reaches the main branch."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Human-Only Merge Gate"},"related":["https://patterns.agenticsystemcore.com/concepts/immutable-audit-log/","https://patterns.agenticsystemcore.com/concepts/plan-approval-gate/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-1","https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-1","@type":"Source","creator":"GitHub","date":"2026","dcterms:source":"https://docs.github.com/en/copilot/concepts/security-governance-and-network-settings/risks-and-mitigations","grade":"primary","title":"Risks and mitigations for GitHub Copilot cloud agent","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/human-only-merge-gate/#source-2","@type":"Source","creator":"Prifti, Y.; De Meo, P.; Provetti, A.","date":"2026","dcterms:source":"https://arxiv.org/abs/2606.20615","grade":"secondary","title":"Specifying AI-SDLC Processes: A Protocol Language for Human-Agent Boundaries","verifiedOn":"2026-11-12T00:00:00Z"}]}
