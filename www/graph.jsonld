rce-3","https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-4"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-1","@type":"Source","creator":"Andrei N. Besleaga","date":"2026","dcterms:source":"https://datatracker.ietf.org/doc/draft-besleaga-sustainability-wellknown/","grade":"primary","title":"The 'sustainability-data' Well-Known URI","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-2","@type":"Source","creator":"Green Web Foundation","date":"2026","dcterms:source":"https://carbontxt.org","grade":"secondary","title":"carbon.txt","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-3","@type":"Source","creator":"Green Software Foundation","date":"2025","dcterms:source":"https://github.com/Green-Software-Foundation/real-time-cloud","grade":"secondary","title":"Real Time Energy and Carbon Standards for Cloud Providers","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/sustainability-signal-plane/#source-4","@type":"Source","creator":"Andrei N. Besleaga","date":"2026","dcterms:source":"https://doi.org/10.5281/zenodo.22056634","grade":"secondary","title":"The Cybernetic Sustainability Loop: Governed Agentic Systems on a Sustainability Data Plane — evaluation package","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/","@type":"Concept","altLabel":[{"@language":"en","@value":"final-state grading"},{"@language":"en","@value":"tool-trajectory match"},{"@language":"en","@value":"trajectory evals"},{"@language":"en","@value":"transcript grading"}],"created":"2026-08-15T00:00:00Z","definition":{"@language":"en","@value":"Grade the end state an agent produced and the path it took as two separate questions, each with a suitable grader."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Trajectory and Outcome Evaluation"},"related":"https://patterns.agenticsystemcore.com/concepts/retrieval-evaluation/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-1","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-2","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-1","@type":"Source","creator":"Grace, M.; Hadfield, J.; Olivares, R.; et al.","date":"2026","dcterms:source":"https://www.anthropic.com/engineering/demystifying-evals-for-ai-agents","grade":"primary","title":"Demystifying evals for AI agents","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-2","@type":"Source","creator":"Google","date":"2026","dcterms:source":"https://adk.dev/evaluate/","grade":"secondary","title":"Why evaluate agents","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/#source-3","@type":"Source","creator":"Huyen, C.","date":"2025","dcterms:source":"https://huyenchip.com/2025/01/07/agents.html","grade":"secondary","title":"Agents","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/","@type":"Concept","altLabel":[{"@language":"en","@value":"infinite loop"},{"@language":"en","@value":"no stopping condition"},{"@language":"en","@value":"runaway agent loop"},{"@language":"en","@value":"unbounded agent loop"}],"created":"2026-08-16T00:00:00Z","definition":{"@language":"en","@value":"An agent loop with no step limit, no budget and no independent exit test runs until money, patience or the platform stops it."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Unbounded Loops"},"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-1","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-2","https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-1","@type":"Source","creator":"Schluntz, E.; Zhang, B.","date":"2024","dcterms:source":"https://www.anthropic.com/engineering/building-effective-agents","grade":"primary","title":"Building effective agents","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-2","@type":"Source","creator":"OWASP Gen AI Security Project","date":"2025","dcterms:source":"https://genai.owasp.org/llmrisk/llm102025-unbounded-consumption/","grade":"secondary","title":"LLM10:2025 Unbounded Consumption","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/unbounded-agent-loops/#source-3","@type":"Source","creator":"Inkog","date":"2026","dcterms:source":"https://inkog.io/glossary/infinite-loop-ai-agent","grade":"secondary","title":"AI Agent Infinite Loop Detection & Prevention","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/","@type":"Concept","altLabel":[{"@language":"en","@value":"can weaker judges oversee stronger agents"},{"@language":"en","@value":"sandwiching experiments"},{"@language":"en","@value":"scalable oversight"},{"@language":"en","@value":"weak-to-strong generalization"}],"created":"2026-08-18T00:00:00Z","definition":{"@language":"en","@value":"Open question: can weaker judges, human or model, reliably oversee agents stronger than themselves? What is known and what is not."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Weak-to-Strong Oversight"},"related":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/#source-1","https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/#source-1","@type":"Source","creator":"Burns, C.; Izmailov, P.; Kirchner, J. H.; et al.","date":"2023","dcterms:source":"https://arxiv.org/abs/2312.09390","grade":"primary","title":"Weak-to-Strong Generalization: Eliciting Strong Capabilities With Weak Supervision","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/#source-2","@type":"Source","creator":"Bowman, S. R.; Hyun, J.; Perez, E.; et al.","date":"2022","dcterms:source":"https://arxiv.org/abs/2211.03540","grade":"secondary","title":"Measuring Progress on Scalable Oversight for Large Language Models","verifiedOn":"2026-09-29T00:00:00Z"}]}
