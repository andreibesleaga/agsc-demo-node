<https://patterns.agenticsystemcore.com/concepts/dual-llm-pattern/> dcterms:created "2026-08-16T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-09-29T00:00:00Z"^^xsd:dateTime ;
    a asc:Concept ;
    skos:altLabel "CaMeL"@en , "capability-based prompt-injection defense"@en , "privileged/quarantined LLM split"@en ;
    skos:definition "Keep the model that can act away from untrusted text: a tool-less model reads it, and plain code passes results between them."@en ;
    skos:inScheme <https://patterns.agenticsystemcore.com/> ;
    skos:prefLabel "Dual-LLM Pattern"@en ;
    schema:license "LicenseRef-AgenticSystemCore-Content-Use-1.0" ;
