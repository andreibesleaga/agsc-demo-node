es hide."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-11-18T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"Specification Gaming"},"related":["https://patterns.agenticsystemcore.com/concepts/goal-setting-and-monitoring/","https://patterns.agenticsystemcore.com/concepts/resolution-rate-metrics/","https://patterns.agenticsystemcore.com/concepts/trajectory-vs-outcome-evals/","https://patterns.agenticsystemcore.com/concepts/weak-to-strong-oversight/"],"schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-1","https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-2","https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-3"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-1","@type":"Source","creator":"Krakovna, V.; Uesato, J.; Mikulik, V.; et al.","date":"2020","dcterms:source":"https://deepmind.google/blog/specification-gaming-the-flip-side-of-ai-ingenuity/","grade":"primary","title":"Specification gaming: the flip side of AI ingenuity","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-2","@type":"Source","creator":"Baker, B.; Huizinga, J.; Gao, L.; et al.","date":"2025","dcterms:source":"https://arxiv.org/abs/2503.11926","grade":"secondary","title":"Monitoring Reasoning Models for Misbehavior and the Risks of Promoting Obfuscation","verifiedOn":"2026-11-12T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/specification-gaming/#source-3","@type":"Source","creator":"Dalrymple, D.; Skalse, J.; Bengio, Y.; et al.","date":"2024","dcterms:source":"https://arxiv.org/abs/2405.06624","grade":"secondary","title":"Towards Guaranteed Safe A