{"@context":"https://patterns.agenticsystemcore.com/ns/context.jsonld","@graph":[{"@id":"https://patterns.agenticsystemcore.com/","@type":"Bundle","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","specVersion":"1.0.0","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/","@type":"Concept","created":"2026-08-06T00:00:00Z","definition":{"@language":"en","@value":"Split a question into parts, search them in parallel, combine the findings and check that every claim has a source."},"inScheme":"https://patterns.agenticsystemcore.com/","kind":"pattern","modified":"2026-09-29T00:00:00Z","operator":"human:andreibesleaga","origin":"imported","prefLabel":{"@language":"en","@value":"The Deep Research Loop"},"related":"https://patterns.agenticsystemcore.com/concepts/parallelization/","schema:license":"LicenseRef-AgenticSystemCore-Content-Use-1.0","source":["https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-1","https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-2"],"status":"stable","usageInfo":"LicenseRef-AgenticSystemCore-Content-Use-1.0"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-1","@type":"Source","creator":"Hadfield, J.; Zhang, B.; Lien, K.; et al.","date":"2025","dcterms:source":"https://www.anthropic.com/engineering/multi-agent-research-system","grade":"primary","title":"How we built our multi-agent research system","verifiedOn":"2026-09-29T00:00:00Z"},{"@id":"https://patterns.agenticsystemcore.com/concepts/deep-research-loop/#source-2","@type":"Source","creator":"Gottweis, J.; Natarajan, V.","date":"2025","dcterms:source":"https://research.google/blog/accelerating-scientific-breakthroughs-with-an-ai-co-scientist/","grade":"secondary","title":"Accelerating scientific breakthroughs with an AI co-scientist","verifiedOn":"2026-09-29T00:00:00Z"}]}
